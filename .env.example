# ==============================================================================
# TRAJECT Environment Configuration Template (.env.example)
# Copy this file to .env at the repository root: Copy-Item .env.example .env
# Replace placeholder values with actual credentials where applicable.
# Do NOT commit .env containing real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Logging
# ------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Telegram Collector Configuration (Telethon / MTProto)
# NOTE: Required ONLY for live collection from Telegram.
# Offline replay, quality checks, and the ML pipeline work 100% offline without these.
# Obtain API credentials from https://my.telegram.org
# ------------------------------------------------------------------------------
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_SESSION=traject_collector_session
TELEGRAM_PHONE=+910000000000

# ------------------------------------------------------------------------------
# 3. Model & Hugging Face Configuration (Optional)
# Public models download automatically without a token. Set HF_TOKEN to avoid rate
# limits or for accessing gated model revisions if needed.
# ------------------------------------------------------------------------------
HF_TOKEN=your_huggingface_token_here

# ------------------------------------------------------------------------------
# 4. Local Storage & Artifact Directories
# All paths can be relative to the repository root.
# ------------------------------------------------------------------------------
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
MODELS_CACHE_DIR=./models/cache
ML_CACHE_PATH=./data/cache/ml_inference_cache.db

# ------------------------------------------------------------------------------
# 5. Backend API Configuration (Milestone 5A)
# ------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 6. Future Platform Configurations (Placeholders for upcoming milestones)
# ------------------------------------------------------------------------------
# X_API_BEARER_TOKEN=your_x_api_bearer_token_here


# ==============================================================================
# TRAJECT Environment Configuration Template (.env.example)
# Copy this file to .env at the repository root: Copy-Item .env.example .env
# Replace placeholder values with actual credentials where applicable.
# Do NOT commit .env containing real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Logging
# ------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Telegram Collector Configuration (Telethon / MTProto)
# NOTE: Required ONLY for live collection from Telegram.
# Offline replay, quality checks, and the ML pipeline work 100% offline without these.
# Obtain API credentials from https://my.telegram.org
# ------------------------------------------------------------------------------
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_SESSION=traject_collector_session
TELEGRAM_PHONE=+910000000000

# Optional runtime collection overrides:
# The canonical production source registry is version-controlled at:
#   backend/config/telegram_sources.json
# You can optionally override active collection sources at runtime via:
# TELEGRAM_SOURCES=@warmonitors,@liveuamap
# TELEGRAM_COLLECTION_LIMIT=10

# ------------------------------------------------------------------------------
# 2.1 Telegram Bot Configuration (aiogram 3.x / Bot API)
# Required to run the interactive Telegram Bot and push live alert notifications.
# Obtain bot token from https://t.me/BotFather
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_ALERT_CHAT_ID=your_target_channel_or_chat_id
BACKEND_API_BASE_URL=http://127.0.0.1:8000/api/v1
BACKEND_WS_URL=ws://127.0.0.1:8000/api/v1/ws/live

# ------------------------------------------------------------------------------
# 3. Model & Hugging Face Configuration (Optional)
# Public models download automatically without a token. Set HF_TOKEN to avoid rate
# limits or for accessing gated model revisions if needed.
# ------------------------------------------------------------------------------
HF_TOKEN=your_huggingface_token_here

# ------------------------------------------------------------------------------
# 4. Local Storage & Artifact Directories
# All paths can be relative to the repository root.
# ------------------------------------------------------------------------------
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
MODELS_CACHE_DIR=./models/cache
ML_CACHE_PATH=./data/cache/ml_inference_cache.db

# ------------------------------------------------------------------------------
# 5. Backend API Configuration (Milestone 5A)
# ------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 6. Future Platform Configurations (Placeholders for upcoming milestones)
# ------------------------------------------------------------------------------
# X_API_BEARER_TOKEN=your_x_api_bearer_token_here

# ------------------------------------------------------------------------------
# 7. Frontend UI Configuration (Vite / React)
# NOTE: Only variables prefixed with VITE_ are bundled into client-side JS.
# Backend secrets above are never exposed to browser users.
# ------------------------------------------------------------------------------
# Base URL for backend telemetry API (matches API_HOST:API_PORT + API_PREFIX)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Toggle mock data layer (true = offline mock data, false = live backend API)
VITE_USE_MOCK_DATA=false

# Collector & metric auto-refresh interval in milliseconds (default: 30 seconds)
VITE_REFRESH_INTERVAL=30000

# Application deployment mode: development | production | demo
VITE_APP_MODE=development

# ------------------------------------------------------------------------------
# 8. Supabase Authentication (Milestone 9A)
# Obtain public credentials from your Supabase project dashboard -> Settings -> API
# NEVER place service_role keys here.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# ------------------------------------------------------------------------------
# 9. Supabase Backend JWT Verification & Role Authorization (Milestone 9B)
# Used by the FastAPI backend to cryptographically verify incoming Bearer JWTs.
# ------------------------------------------------------------------------------
# Public JWKS endpoint URL for asymmetric token verification (RS256/ES256)
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Expected token issuer
SUPABASE_ISSUER=https://your-project-ref.supabase.co/auth/v1

# Expected token audience
SUPABASE_AUDIENCE=authenticated

# Optional Supabase JWT Secret for symmetric token verification (HS256)
# NEVER commit the real secret to version control.
# SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Optional comma-separated email whitelist for NTRO Analyst role assignment
NTRO_ANALYST_EMAILS=analyst@ntro.gov.in,director@ntro.gov.in


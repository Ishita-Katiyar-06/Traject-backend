# ==============================================================================
# TRAJECT Frontend Environment Configuration Template
# NOTE: The project uses a single unified .env file located at the repository root:
# Copy the root .env.example: Copy-Item ..\.env.example ..\.env
# frontend/vite.config.ts is configured with envDir: '../' to load from root.
# ==============================================================================

# API Base URL for backend telemetry services (FastAPI)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Enable or disable mock data layer (true = offline mock data, false = live backend API)
VITE_USE_MOCK_DATA=false


# Collector refresh interval in milliseconds (default: 30 seconds)
VITE_REFRESH_INTERVAL=30000

# Application deployment mode: development | production | demo
VITE_APP_MODE=development

# ------------------------------------------------------------------------------
# Supabase Authentication (Milestone 9A)
# Obtain public credentials from your Supabase project dashboard -> Settings -> API
# NEVER place service_role keys here.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here
